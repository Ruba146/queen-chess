generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// USER MODEL
// ============================================================
// Each user has one-to-many relations with:
//   - UserStat (1 per mode: rapid, blitz, bullet)
//   - RatingHistory (per rating change event)
//   - Game, AIMemory, DailyMission, Chat
// ============================================================
model User {
  id                   String @id @default(cuid())
  username             String
  email                String @unique
  password             String
  displayName          String @default("")
  profilePicture       String @default("")
  preferredSide        String @default("random")
  mostPlayedDifficulty String @default("intermediate")
  favoriteOpening      String @default("Unknown")

  // Level system
  playerLevel         String    @default("Beginner")
  totalAccuracySum    Int       @default(0)
  totalAccuracyGames  Int       @default(0)
  consistencyScore    Int       @default(0)
  totalCentipawnLoss  Int       @default(0)
  totalCentipawnGames Int       @default(0)
  dailyStreak         Int       @default(0)
  lastActiveDate      DateTime?
  puzzleCurrentStreak Int       @default(0)
  xp                  Int       @default(0)
  level               Int       @default(1)
  puzzleRating        Int       @default(1000)
  puzzleHighestRating Int       @default(1000)

  // Achievements (native Postgres string array — not JSON)
  achievements String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  userStats       UserStat[]
  ratingHistories RatingHistory[]
  games           Game[]
  aiMemory        AIMemory?
  dailyMissions   DailyMission[]
  chats           Chat[]
  puzzleProgress  UserPuzzleProgress[]
  collectionProgress UserPuzzleCollectionProgress[]
  puzzleRatingHistory UserPuzzleRatingHistory[]
  puzzleThemeStats UserPuzzleThemeStats[]
  survivalRecords UserSurvivalRecord[]
  challengeCompletions UserChallengeCompletion[]
}

// ============================================================
// USER STAT — Per-mode stats for rapid, blitz, bullet
// ============================================================
// Replaces legacy embedded: user.ratings, user.stats,
// user.bestRating, user.gamesPlayed, user.winStreak
// ============================================================
model UserStat {
  id          String @id @default(cuid())
  userId      String
  mode        String // "rapid" | "blitz" | "bullet"
  rating      Int    @default(1200)
  bestRating  Int    @default(1200)
  gamesPlayed Int    @default(0)
  winStreak   Int    @default(0)
  wins        Int    @default(0)
  losses      Int    @default(0)
  draws       Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mode])
  @@index([userId])
}

// ============================================================
// RATING HISTORY — Individual rating change events
// ============================================================
// Replaces legacy embedded: user.ratingHistory[mode][]
// Each entry records a rating after a game for charting.
// ============================================================
model RatingHistory {
  id     String   @id @default(cuid())
  userId String
  mode   String // "rapid" | "blitz" | "bullet"
  rating Int
  date   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, mode])
  @@index([userId, date])
}

// ============================================================
// GAME MODEL
// ============================================================
// Stores completed chess games with all analysis data.
// Relations:
//   - User (creator/player)        N:1
//   - GameMoveAnalysis (per move)  1:N
//   - GameEvalData (per position)  1:N
// ============================================================
model Game {
  id          String  @id @default(cuid())
  userId      String
  mode        String  @default("rapid")
  result      String  @default("unknown")
  opening     String  @default("Unknown Opening")
  accuracy    Int     @default(0)
  pgn         String?
  playerColor String  @default("white")
  difficulty  String  @default("intermediate")
  duration    Int     @default(0)

  // ELO ratings (flattened from ratingsBefore/After objects)
  ratingsBeforePlayer1 Int @default(1200)
  ratingsBeforePlayer2 Int @default(1200)
  ratingsAfterPlayer1  Int @default(1200)
  ratingsAfterPlayer2  Int @default(1200)

  ratingAfterGame      Int    @default(1200)
  rankAfterGame        String @default("Beginner")
  playerLevelAfterGame String @default("Beginner")
  ratingChange         Int    @default(0)

  // Labels (flattened from labels{} object)
  labelOutcome    String @default("unknown")
  labelColor      String @default("white")
  labelOpening    String @default("Unknown")
  labelDifficulty String @default("intermediate")

  // Rating snapshot (flattened from ratingSnapshot{} object)
  snapshotBefore Int @default(1200)
  snapshotAfter  Int @default(1200)
  snapshotChange Int @default(0)

  // Phase scores
  openingScore     Int @default(0)
  middleGameScore  Int @default(0)
  endgameScore     Int @default(0)
  performanceScore Int @default(0)

  // Move statistics
  bestMoves      Int @default(0)
  excellentMoves Int @default(0)
  goodMoves      Int @default(0)
  inaccuracies   Int @default(0)
  mistakes       Int @default(0)
  blunders       Int @default(0)
  brilliantMoves Int @default(0)
  missedWins     Int @default(0)

  // Analysis scores
  averageCentipawnLoss Int    @default(0)
  materialBalance      Int    @default(0)
  pieceActivityScore   Int    @default(0)
  kingSafetyScore      Int    @default(0)
  endgameQualityScore  Int    @default(0)
  tacticalAbilityScore Int    @default(0)
  positionalPlayScore  Int    @default(0)
  decisionMakingScore  Int    @default(0)
  consistencyScore     Int    @default(0)
  playingStyle         String @default("Balanced")

  // Training dataset fields
  isTrainingDataset Boolean @default(false)
  parentGameId      String?
  totalMoves        Int     @default(0)
  outcome           String  @default("unknown")

  // Native Postgres string arrays (not JSON)
  moves                String[] @default([])
  strengths            String[] @default([])
  weaknesses           String[] @default([])
  coachRecommendations String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  moveAnalyses GameMoveAnalysis[]
  evalData     GameEvalData[]

  @@index([userId])
  @@index([isTrainingDataset])
  @@index([parentGameId])
}

// ============================================================
// GAME MOVE ANALYSIS — Per-move detailed analysis
// ============================================================
// Replaces legacy embedded: game.moveAnalysis[]
// Also covers game.moveRecords[] (same structure)
// Each row = one move in one game with its classification
// ============================================================
model GameMoveAnalysis {
  id             String @id @default(cuid())
  gameId         String
  moveNumber     Int
  move           String
  classification String // "Best" | "Excellent" | "Good" | "Inaccuracy" | "Mistake" | "Blunder"
  loss           Int    @default(0)
  evalBefore     Int    @default(0)
  evalAfter      Int    @default(0)
  phase          String // "opening" | "middlegame" | "endgame"

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
  @@index([gameId, moveNumber])
  @@index([gameId, phase])
  @@index([gameId, classification])
}

// ============================================================
// GAME EVAL DATA — Per-position evaluation for graph display
// ============================================================
// Replaces legacy embedded: game.evaluationData[]
// Each row = evaluation snapshot at one move
// ============================================================
model GameEvalData {
  id         String @id @default(cuid())
  gameId     String
  moveNumber Int
  playerEval Int    @default(0)
  bestEval   Int    @default(0)
  diff       Int    @default(0)

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
  @@index([gameId, moveNumber])
}

// ============================================================
// AI MEMORY
// ============================================================
// One-to-one with User. Each user has one AIMemory record
// that contains multiple AIMemoryEntry entries.
// ============================================================
model AIMemory {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries AIMemoryEntry[]
}

// ============================================================
// AI MEMORY ENTRY — Individual memory facts
// ============================================================
// Replaces legacy embedded: aiMemory.memories[]
// Each entry = one piece of information the AI remembers
// about the user (skill level, favorite opening, goals, etc.)
// ============================================================
model AIMemoryEntry {
  id         String   @id @default(cuid())
  memoryId   String
  key        String
  value      String
  category   String   @default("general") // opening | skill | preference | goal | weakness | training | general
  confidence Float    @default(0.5)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  memory AIMemory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@index([memoryId])
  @@index([memoryId, category])
  @@index([memoryId, key])
}

// ============================================================
// CHAT
// ============================================================
// A conversation between a user and the AI coach.
// One-to-many with Message.
// ============================================================
model Chat {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("New Chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId])
  @@index([userId, updatedAt])
}

// ============================================================
// MESSAGE
// ============================================================
// Individual messages within a chat conversation.
// Belongs to one Chat.
// ============================================================
model Message {
  id        String   @id @default(cuid())
  chatId    String
  role      String // "user" | "assistant"
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId])
  @@index([chatId, createdAt])
}

// ============================================================
// DAILY MISSION
// ============================================================
// Daily missions assigned to a user.
// One-to-many with MissionItem.
// One per user per day (unique constraint on userId + date).
// ============================================================
model DailyMission {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  missions MissionItem[]

  @@unique([userId, date])
  @@index([userId])
}

// ============================================================
// MISSION ITEM
// ============================================================
// Individual tasks within a daily mission.
// Replaces legacy embedded: dailyMission.missions[]
// Each item tracks progress toward a specific goal.
// ============================================================
model MissionItem {
  id          String   @id @default(cuid())
  missionId   String
  title       String
  description String   @default("")
  type        String // puzzle | opening | game | analysis | endgame | lesson | tactic
  target      Int      @default(1)
  progress    Int      @default(0)
  completed   Boolean  @default(false)
  xpReward    Int      @default(10)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  mission DailyMission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([missionId])
}

// ============================================================
// AI CACHE — For caching LLM responses
// ============================================================
// Replaces the legacy ai_cache collection used by aiResponseCache.
// Stores cached AI responses with TTL.
// ============================================================
model AICache {
  id        String   @id @default(cuid())
  key       String   @unique
  data      String // JSON stringified data
  ttl       DateTime
  createdAt DateTime @default(now())

  @@index([key])
  @@index([ttl])
}

// ============================================================
// PUZZLE — Individual chess puzzle
// ============================================================
model Puzzle {
  id            String   @id @default(cuid())
  fen           String
  solution      String[]
  theme         String
  category      String
  difficulty    String   @default("intermediate")
  explanation   String?
  hint          String?
  evaluation    String?
  goal          String   @default("Find the best move")
  rating        Int      @default(1000)
  generatedByAI Boolean  @default(false)
  completed     Boolean  @default(false)
  attempts      Int      @default(0)
  solveCount    Int      @default(0)
  successRate   Float    @default(0)
  solvedAt      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userProgress UserPuzzleProgress[]

  @@index([category])
  @@index([theme])
  @@index([difficulty])
  @@index([generatedByAI])
}

// ============================================================
// USER PUZZLE PROGRESS — Per-user per-puzzle completion
// ============================================================
model UserPuzzleProgress {
  id         String   @id @default(cuid())
  userId     String
  puzzleId   String
  completed  Boolean  @default(false)
  attempts   Int      @default(0)
  solvedAt   DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  puzzle Puzzle @relation(fields: [puzzleId], references: [id], onDelete: Cascade)

  @@unique([userId, puzzleId])
  @@index([userId])
  @@index([userId, completed])
}

// ============================================================
// USER PUZZLE COLLECTION PROGRESS — Per-user per-category progress
// ============================================================
model UserPuzzleCollectionProgress {
  id                 String    @id @default(cuid())
  userId             String
  category           String
  totalPuzzles       Int       @default(0)
  completedPuzzles   Int       @default(0)
  currentPuzzleIndex Int       @default(0)
  accuracy           Int       @default(0)
  bestStreak         Int       @default(0)
  xpEarned           Int       @default(0)
  lastPlayed         DateTime?
  completionPct      Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([userId])
  @@index([userId, lastPlayed])
}

// ============================================================
// USER PUZZLE RATING HISTORY
// ============================================================
model UserPuzzleRatingHistory {
  id        String   @id @default(cuid())
  userId    String
  rating    Int
  change    Int      @default(0)
  reason    String   @default("puzzle_completion")
  puzzleId  String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
}

// ============================================================
// USER PUZZLE THEME STATS
// ============================================================
model UserPuzzleThemeStats {
  id        String   @id @default(cuid())
  userId    String
  theme     String
  attempts  Int      @default(0)
  solved    Int      @default(0)
  accuracy  Float    @default(0)
  avgTime   Int      @default(0)
  mastery   Float    @default(0)
  lastPlayed DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, theme])
  @@index([userId])
  @@index([userId, mastery])
}

// ============================================================
// DAILY CHALLENGE
// ============================================================
model DailyChallenge {
  id          String   @id @default(cuid())
  puzzleId    String
  date        DateTime @unique
  theme       String   @default("tactics")
  difficulty  String   @default("intermediate")
  bonusXP     Int      @default(50)
  createdAt   DateTime @default(now())
}

model WeeklyChallenge {
  id          String   @id @default(cuid())
  puzzleId    String
  weekStart   DateTime @unique
  theme       String   @default("tactics")
  difficulty  String   @default("advanced")
  bonusXP     Int      @default(200)
  description String   @default("Weekly Challenge")
  createdAt   DateTime @default(now())
}

model UserChallengeCompletion {
  id            String   @id @default(cuid())
  userId        String
  challengeType String   // "daily" | "weekly"
  challengeId   String
  completed     Boolean  @default(false)
  attempts      Int      @default(0)
  solveTime     Int?     @default(0)
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeType, challengeId])
  @@index([userId])
  @@index([userId, challengeType])
}

// ============================================================
// USER SURVIVAL RECORD
// ============================================================
model UserSurvivalRecord {
  id        String   @id @default(cuid())
  userId    String
  streak    Int      @default(0)
  bestStreak Int     @default(0)
  totalPuzzles Int   @default(0)
  totalCorrect Int   @default(0)
  category  String   @default("survival-mode")
  lastPlayed DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([userId])
}
